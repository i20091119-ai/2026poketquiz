{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poke-quiz",
  // 게임을 올리는 Cloudflare 계정 (i20091119@gmail.com)
  "account_id": "3baf945a4393bacb79ceacb36bd1d792",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // 정적 파일 설정. /battle/* 은 비밀번호 문(app/battle/[[...path]]/route.ts)을 거치도록 Worker 가 먼저 받습니다.
  // 첫 화면(index.html)만은 정적으로 바로 내보내고, 그 안의 확인 스크립트가 문이 잠겨 있으면 로그인 화면으로 보냅니다.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/battle/*", "!/battle/", "!/battle/index.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poke-quiz-db",
      // 기록 저장소 번호. GitHub 자동 작업(또는 npm run online)이 올릴 때 자동으로 채웁니다.
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
